# Configuración de Aplicación
APP_ENV=local
APP_DEBUG=false
APP_KEY=replace-with-at-least-32-random-characters
APP_URL=http://localhost:8081
APP_TIMEZONE=America/Argentina/Buenos_Aires
SESSION_SECURE_COOKIE=false

# Configuración de Base de Datos MySQL (Interna al Contenedor Docker)
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=drugstore
DB_USERNAME=drugstore
DB_PASSWORD=replace-database-password
DB_ROOT_PASSWORD=replace-root-password

# Puertos Expuestos en el Host Local (Docker Compose)
APP_PORT=8081
DB_FORWARD_PORT=3307
